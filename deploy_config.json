{
  "server": {
    "ip": "101.132.154.143",
    "user": "root",
    "remote_path": "/data/apps/novel_writing_agent"
  },
  "upload": {
    "strategy": "Auto"
  },
  "sync_rules": {
    "backend": {
      "include": [
        "backend/app/**/*.py",
        "backend/app/**/*.json",
        "backend/alembic/**/*.py",
        "backend/backend/data/**/*.json",
        "backend/*.ini",
        "backend/requirements.txt",
        "backend/*.json",
        "backend/Dockerfile"
      ],
      "exclude": [
        "backend/**/__pycache__/**",
        "backend/**/*.pyc",
        "backend/.venv/**",
        "backend/data/**",
        "backend/memory_data/**",
        "backend/runs/**"
      ]
    },
    "frontend": {
      "include": [
        "frontend/src/**/*.tsx",
        "frontend/src/**/*.ts",
        "frontend/src/**/*.css",
        "frontend/src/**/*.json",
        "frontend/public/**/*",
        "frontend/package.json",
        "frontend/package-lock.json",
        "frontend/vite.config.ts",
        "frontend/*.conf",
        "frontend/*.json",
        "frontend/*.js",
        "frontend/*.ts",
        "frontend/*.html",
        "frontend/Dockerfile"
      ],
      "exclude": [
        "frontend/node_modules/**",
        "frontend/.next/**",
        "frontend/dist/**",
        "frontend/build/**"
      ]
    },
    "agents": {
      "include": [
        "agents/**/*.py"
      ],
      "exclude": []
    },
    "adapters": {
      "include": [
        "adapters/**/*.py"
      ],
      "exclude": []
    },
    "pipeline": {
      "include": [
        "pipeline/**/*.py"
      ],
      "exclude": []
    },
    "shared": {
      "include": [
        "shared/**/*.py",
        "core/**/*.py",
        "schemas/**/*.py",
        "config/**/*.json",
        "config/**/*.yml",
        "config/**/*.yaml"
      ],
      "exclude": []
    },
    "config": {
      "include": [
        "docker-compose.yml",
        "nginx-prod.conf",
        ".env.example",
        "deploy_config.json"
      ],
      "exclude": []
    }
  },
  "build": {
    "backend": {
      "rebuild": true,
      "no_cache": false,
      "timeout": 600
    },
    "frontend": {
      "rebuild": true,
      "restart": true
    }
  },
  "validation": {
    "check_api": true,
    "api_endpoint": "/health",
    "timeout": 30
  }
}
