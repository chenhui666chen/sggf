# ==================== 模型 API 与有声小说 TTS ====================
# 后端实际加载顺序：backend/.env -> 仓库根目录 .env；根目录 .env.local 当前不会被后端自动读取。
# .env.example 只放占位符。真实密钥请写入 backend/.env 或部署平台密钥管理，不要提交到代码仓库。

# DeepSeek 官方 API 配置（用于 deepseek-v4-pro / deepseek-v4-flash）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MODEL_NAME=deepseek-v4-pro

# 阿里云百炼 API 配置（用于 Qwen / Embedding / Qwen3-TTS / CosyVoice / MiniMax / Wan 等 DashScope 能力）
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen3-TTS Instruct Flash 实际调用模型 ID；鉴权仍使用 DASHSCOPE_API_KEY。
QWEN3_TTS_FLASH_MODEL_ID=qwen3-tts-instruct-flash

# MiMo V2.5 TTS（预置音色 / 音色设计 / 音色克隆）
MIMO_API_KEY=your-mimo-api-key-here

# StepAudio 2.5 TTS（Contextual TTS / Zero-shot 音色复刻）
STEP_API_KEY=your-stepfun-api-key-here
# 可选别名，代码会按 STEP_API_KEY -> STEPFUN_API_KEY 查找：
# STEPFUN_API_KEY=your-stepfun-api-key-here
STEPAUDIO_TTS_BASE_URL=https://api.stepfun.com/v1

# 豆包 Seed-TTS 2.0 Expressive / Seed Speech 语音合成配置
# 注意：这里需要 openspeech/Seed Speech 的专用 X-Api-Key，不要复用火山方舟通用 VOLCENGINE_API_KEY / DOUBAO_API_KEY。
VOLCENGINE_TTS_API_KEY=your-volcengine-seed-speech-api-key-here
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
# 可选别名，代码会按 VOLCENGINE_TTS_API_KEY -> DOUBAO_TTS_API_KEY -> SEED_TTS_API_KEY -> VOLCENGINE_SPEECH_API_KEY -> DOUBAO_SPEECH_API_KEY 查找：
# DOUBAO_TTS_API_KEY=your-volcengine-seed-speech-api-key-here
# SEED_TTS_API_KEY=your-volcengine-seed-speech-api-key-here
# VOLCENGINE_SPEECH_API_KEY=your-volcengine-seed-speech-api-key-here
# DOUBAO_SPEECH_API_KEY=your-volcengine-seed-speech-api-key-here
# 可选旧鉴权兼容字段；未设置时后端使用 VOLCENGINE_TTS_API_KEY 兜底。
# VOLCENGINE_TTS_APP_KEY=your-volcengine-tts-app-key-here
# 可选 endpoint 覆盖；默认值如下。
SEED_TTS_HTTP_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional

# 火山方舟 / 豆包通用模型（Seed / Seedance / Seedream 等）。注意：不能作为 Seed-TTS X-Api-Key 使用。
DOUBAO_API_KEY=your-doubao-api-key-here
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# AI 音乐 / 音效与公开素材库
MUREKA_API_KEY=your-mureka-api-key-here
MUREKA_API_URL=https://api.mureka.ai
VIDU_API_KEY=your-vidu-api-key-here
VIDU_API_URL=https://api.vidu.cn/ent/v2
FREESOUND_API_KEY=
PIXABAY_API_KEY=

# Audiobook shared audio library cloud storage
AUDIOBOOK_AUDIO_LIBRARY_STORAGE_DRIVER=local_fs
AUDIOBOOK_AUDIO_LIBRARY_OSS_PREFIX=shared/audio_library
AUDIOBOOK_AUDIO_LIBRARY_OSS_POLICY_MODEL=cosyvoice-v3.5-plus
# Self-owned Aliyun OSS driver. Use a RAM user/role with least privilege.
# AUDIOBOOK_AUDIO_LIBRARY_STORAGE_DRIVER=aliyun_oss
# AUDIOBOOK_AUDIO_LIBRARY_OSS_BUCKET=sggf-audio-library
# AUDIOBOOK_AUDIO_LIBRARY_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# AUDIOBOOK_AUDIO_LIBRARY_OSS_ACCESS_KEY_ID=
# AUDIOBOOK_AUDIO_LIBRARY_OSS_ACCESS_KEY_SECRET=
# Optional when using temporary STS credentials:
# AUDIOBOOK_AUDIO_LIBRARY_OSS_SECURITY_TOKEN=
# Enable only after audio.sggf.net DNS/OSS/HTTPS mapping is verified:
# AUDIOBOOK_AUDIO_LIBRARY_OSS_PUBLIC_HOST=https://audio.sggf.net

# 向量数据库配置
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Embedding模型配置（选择其中一种）

# 选项1：阿里云百炼 embedding（推荐，效果最好）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=your-dashscope-api-key-here
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 选项2：OpenAI embedding
# EMBEDDING_MODEL=text-embedding-ada-002
# EMBEDDING_API_KEY=your_openai_api_key
# EMBEDDING_API_BASE=https://api.openai.com/v1

# 选项3：DeepSeek（暂不支持embedding，会使用fallback）

# 选项4：本地模型
# EMBEDDING_MODEL=local
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE=

# Agent配置
TEMPERATURE=0.7
MAX_CONTEXT_LENGTH=4000

# 多模型质量评审（高级功能，默认关闭）
MULTI_MODEL_REVIEW_CONCURRENCY=5
MULTI_MODEL_REVIEW_TIMEOUT_SECONDS=120
MULTI_MODEL_REVIEW_CHIEF_TIMEOUT_SECONDS=120
MULTI_MODEL_REVIEW_DEFAULT_PRESET=balanced_3
MULTI_MODEL_REVIEW_MAX_REVIEWERS=7
MULTI_MODEL_REVIEW_CHIEF_MODEL=deepseek-v4-pro
MULTI_MODEL_REVIEW_DEFAULT_PROMPT_BUDGET=80000
MULTI_MODEL_REVIEW_CHAPTER_PLAN_PROMPT_BUDGET=12000
DOUBAO_REVIEW_PROMPT_BUDGET=64000

# Celery 任务队列
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==================== 认证与找回密码 ====================

# 后端当前仅支持 PostgreSQL
DATABASE_URL=postgresql://novel_user:your_postgres_password@127.0.0.1:5432/novel_db
REDIS_URL=redis://localhost:6379/0

# Nginx SSL 证书路径（生产环境建议指向宿主机上的 Let's Encrypt 证书）
# 本地默认可不设置，将回退到仓库中的 ssl/cert.pem 与 ssl/key.pem 占位文件
NGINX_SSL_CERT_PATH=/etc/letsencrypt/live/sggf.net/fullchain.pem
NGINX_SSL_KEY_PATH=/etc/letsencrypt/live/sggf.net/privkey.pem

# 邮件发送配置（正式找回密码必填）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=拾光工坊
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# 找回密码配置
PASSWORD_RESET_CODE_TTL_SECONDS=600
PASSWORD_RESET_RESEND_INTERVAL_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_LENGTH=6

# ==================== 短剧生成链路配置 ====================

# Wan系列模型配置
WAN_T2I_API_KEY=your_wan_t2i_api_key_here
WAN_T2I_BASE_URL=https://api.wan.example.com
WAN_T2I_MODEL_NAME=wanx-v1
WAN_T2I_TIMEOUT=60
# DashScope AIGC 异步任务轮询（当 WAN_T2I_BASE_URL 指向 dashscope 时尤其重要）
WAN_T2I_TASK_TIMEOUT=1800
WAN_T2I_POLL_HTTP_TIMEOUT=15
WAN_T2I_POLL_INTERVAL_S=2

WAN_I2V_API_KEY=your_wan_i2v_api_key_here
WAN_I2V_BASE_URL=https://api.wan.example.com
WAN_I2V_MODEL_NAME=wan2.7-i2v
WAN_I2V_TIMEOUT=600

WAN_T2V_API_KEY=your_wan_t2v_api_key_here
WAN_T2V_BASE_URL=https://api.wan.example.com
WAN_T2V_MODEL_NAME=wan2.7-t2v
WAN_T2V_TIMEOUT=600

WAN_R2V_API_KEY=your_wan_r2v_api_key_here
WAN_R2V_BASE_URL=https://api.wan.example.com
WAN_R2V_MODEL_NAME=wanx-v1-r2v
WAN_R2V_TIMEOUT=600

# Qwen系列模型配置
QWEN_IMAGE_EDIT_API_KEY=your_qwen_image_edit_api_key_here
QWEN_IMAGE_EDIT_BASE_URL=https://api.qwen.example.com
QWEN_IMAGE_EDIT_MODEL_NAME=qwen-image-edit-plus
QWEN_IMAGE_EDIT_MAX_API_KEY=your_qwen_image_edit_api_key_here
QWEN_IMAGE_EDIT_MAX_BASE_URL=https://api.qwen.example.com
QWEN_IMAGE_EDIT_MAX_MODEL_NAME=qwen-image-edit-max-2026-01-16

QWEN_VL_PLUS_API_KEY=your_qwen_vl_plus_api_key_here
QWEN_VL_PLUS_BASE_URL=https://api.qwen.example.com

# 剪影API配置
JIANYING_API_KEY=your_jianying_api_key_here
JIANYING_BASE_URL=https://api.jianying.example.com

# FFmpeg配置
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ==================== DreamWeaver（织梦映心）增强开关 ====================

# 是否强制所有“文本→结构化”阶段必须使用 LLM（不允许规则回退）
DREAMWEAVER_LLM_ONLY=false
# 状态机执行步数预算（用于大规模素材库增量生成）
DREAMWEAVER_PIPELINE_MAX_STEPS_BASE=50
DREAMWEAVER_PIPELINE_MAX_STEPS_CAP=500

# 文本→剧本→分镜（默认启用 LLM；Qwen 模型读取 DASHSCOPE_API_KEY，DeepSeek V4 模型读取 DEEPSEEK_API_KEY）
DREAMWEAVER_PLANNER_ENABLE_LLM=true
DREAMWEAVER_PLANNER_MODEL=qwen-plus
DREAMWEAVER_SCRIPT_ENABLE_LLM=true
DREAMWEAVER_SCRIPT_MODEL=qwen-plus
# 分场上限：0=自动（推荐，随文本长度调整）；>0=固定上限
DREAMWEAVER_SCRIPT_MAX_SCENES=0
# 分场下限与“按文本长度自动估算”的节奏参数（字数越多→分场越多）
DREAMWEAVER_SCRIPT_MIN_SCENES=6
# LLM 分场估算口径（用于“偏短”判定与扩写重试），建议比规则拆分更保守
DREAMWEAVER_SCRIPT_HINT_CHARS_PER_SCENE=300
# 规则回退拆分口径（影响 fallback 生成的分场密度）
DREAMWEAVER_SCRIPT_CHARS_PER_SCENE=120
# LLM 自动扩写/重试次数（quality 默认 2；cost 默认 1）
DREAMWEAVER_SCRIPT_LLM_RETRIES=2
DREAMWEAVER_SCRIPT_TEMPERATURE=0.3
DREAMWEAVER_STORYBOARD_ENABLE_LLM=true
DREAMWEAVER_STORYBOARD_MODEL=qwen-plus
# 分镜最大镜头数：0=自动（随剧本场次估算，默认至少 12）；>0=固定
DREAMWEAVER_STORYBOARD_MAX_SHOTS=0

# 分镜时长：规则/回退模式按文本长度估算，避免整体过短（默认 3~10 秒）
DREAMWEAVER_STORYBOARD_MIN_SHOT_S=3.0
DREAMWEAVER_STORYBOARD_MAX_SHOT_S=10.0
DREAMWEAVER_STORYBOARD_BASE_S=2.0
DREAMWEAVER_STORYBOARD_CHARS_PER_SECOND=20.0

# 幻灯片合成效果：static / kenburns（默认 kenburns，会有轻微推拉）
DREAMWEAVER_SLIDESHOW_EFFECT=kenburns
DREAMWEAVER_SLIDESHOW_ZOOM_STEP=0.0008
DREAMWEAVER_SLIDESHOW_MAX_ZOOM=1.08

# 剧本审核门禁（默认开启：停在 waiting_script_approval）
DREAMWEAVER_REQUIRE_SCRIPT_APPROVAL=true

# 多候选出图与评选（默认保持最省成本）
DREAMWEAVER_T2I_CANDIDATES=1
DREAMWEAVER_MID_CANDIDATES=1
# 候选生成并行度：0=自动（候选>1 时默认 2）；1=串行；>=2=并行
DREAMWEAVER_CANDIDATE_PARALLELISM=0
# 关键帧镜头级并行度：默认 1；>=2 并行（会按 camera tree/锚点依赖做调度）
DREAMWEAVER_KEYFRAMES_PARALLELISM=1
# I2V 逐镜头并行度：默认 1；>=2 并行生成不同镜头视频
DREAMWEAVER_VIDEO_PARALLELISM=1
# 视频逐镜头确认：true=VIDEO 阶段先生成任务卡并等待确认（默认 false）
DREAMWEAVER_VIDEO_REQUIRE_CONFIRMATION=false
DREAMWEAVER_VIDEO_ENGINE=wan2.7-i2v
DREAMWEAVER_VIDEO_PROVIDER_MODE=wan_only
DREAMWEAVER_VIDEO_SELECTOR_MODE=off
DREAMWEAVER_ALLOW_KLING_OMNI=false
DREAMWEAVER_ALLOW_SUBJECT_BRIDGE=false
DREAMWEAVER_ALLOW_SUBJECT_BRIDGE_AUTO_SYNC=false
DREAMWEAVER_ENABLE_KLING_VIDEO_PROVIDER=false
DREAMWEAVER_KLING_VIDEO_TIMEOUT_S=300
DREAMWEAVER_KLING_VIDEO_POLL_INTERVAL_S=3

KLING_TOKEN=
KLINGAI_ACCESS_KEY=
KLINGAI_SECRET_KEY=
KLINGAI_API_BASE=https://api.klingai.com
KLING_VIDEO_TEXT_TO_VIDEO_PATH=/v1/videos/text2video
KLING_VIDEO_IMAGE_TO_VIDEO_PATH=/v1/videos/image2video
KLING_VIDEO_VIDEO_TO_VIDEO_PATH=/v1/videos/video2video
KLING_VIDEO_QUERY_PATH_TEMPLATE=/v1/videos/{task_id}

# EDIT subtitles (ASS burn-in). PlayRes prefers probing the first clip via FFPROBE_PATH.
DREAMWEAVER_ENABLE_SUBTITLES=true
DREAMWEAVER_SUBTITLE_FONT_NAME=Arial
# 0=auto scale by resolution
DREAMWEAVER_SUBTITLE_FONT_SIZE=0
# 0=auto margins (safe area)
DREAMWEAVER_SUBTITLE_MARGIN_V=0
DREAMWEAVER_SUBTITLE_MARGIN_LR=0
# ASS Alignment: 1~9 (2=bottom-center)
DREAMWEAVER_SUBTITLE_ALIGNMENT=2
# Outline/Shadow (0~10)
DREAMWEAVER_SUBTITLE_OUTLINE=2
DREAMWEAVER_SUBTITLE_SHADOW=0
# Safe-area percent (0~0.2): minimum margin values (0=disabled)
DREAMWEAVER_SUBTITLE_SAFE_AREA_V_PCT=0
DREAMWEAVER_SUBTITLE_SAFE_AREA_LR_PCT=0

# 音频同步开关（用于声画同步）
DREAMWEAVER_AUDIO_SYNC_ENABLED=true
# 对白口型对齐策略：tts / estimate / off（回滚：设为 off）
DREAMWEAVER_DIALOGUE_LIPSYNC_MODE=tts
# 口型轨道开关：true 输出 viseme_tracks，false 回滚为不输出
DREAMWEAVER_LIPSYNC_TRACKS_ENABLED=true
# 是否把对白音频嵌入视频（方案B默认false；回滚：保持false）
DREAMWEAVER_DIALOGUE_AUDIO_EMBED=false
# 音频策略提示词开关：false 回滚为不追加"仅音效/无BGM"
DREAMWEAVER_AUDIO_POLICY_HINT_ENABLED=true
# 音效来源：model / library / none
DREAMWEAVER_SFX_SOURCE=model
# 是否启用镜头音效合成（library模式用）
DREAMWEAVER_SFX_ENABLED=false
# 是否自动补齐缺失音效素材（仅library模式）
DREAMWEAVER_SFX_AUTO_GENERATE=false
# 角色档案（用于角色一致性）
DREAMWEAVER_ENABLE_CHARACTER_PROFILES=true
# 音频标记（用于声画同步提示）
DREAMWEAVER_ENABLE_AUDIO_MARKERS=true

# 火山引擎 Doubao API 配置使用顶部“模型 API 与有声小说 TTS”分组中的 DOUBAO_API_KEY / DOUBAO_API_BASE。

# 素材库（角色/场景/道具）并发生成：每次 asset_library.run() 最多并发生成 N 个
DREAMWEAVER_ASSET_LIBRARY_PARALLELISM=1
DREAMWEAVER_LIBRARY_MANUAL=true
DREAMWEAVER_LIBRARY_CHARACTER_VIEWS=front,bust_front,side,bust_three_quarter,bust_side,back

# 生成结果哈希缓存（命中直接复用，默认关闭）
DREAMWEAVER_HASH_CACHE=false
DREAMWEAVER_HASH_CACHE_DIR=runs/_hash_cache/images
# first / file_size / vlm / semantic
DREAMWEAVER_IMAGE_SELECTOR=first
# Director(pass/fail)：仅在 DREAMWEAVER_IMAGE_SELECTOR=semantic 时生效
DREAMWEAVER_DIRECTOR_PASS_THRESHOLD=0.72
DREAMWEAVER_DIRECTOR_MIN_QUALITY=0.55
DREAMWEAVER_DIRECTOR_MIN_CHARACTER=0.60
DREAMWEAVER_DIRECTOR_MIN_SCENE=0.55
DREAMWEAVER_DIRECTOR_MIN_TRANSITION=0.50
DREAMWEAVER_DIRECTOR_MIN_DESCRIPTION=0.60
# 图像编辑 vs 文生图 分流策略：always / auto / never
DREAMWEAVER_IMAGE_EDIT_POLICY=always
# 图像编辑抽卡数：0=自动（默认=min(2, t2i_candidates)）；>=1=固定
DREAMWEAVER_IMAGE_EDIT_CANDIDATES=0
# 是否保留候选文件（runs/{run_id}/candidates/）
DREAMWEAVER_KEEP_CANDIDATES=false

# 图片编辑（单参考图）
DREAMWEAVER_HEAD_USE_IMAGE_EDIT=false
DREAMWEAVER_TAIL_USE_IMAGE_EDIT=false
DREAMWEAVER_MID_USE_IMAGE_EDIT=false
DREAMWEAVER_IMAGE_EDIT_ADAPTER=wan_image_edit
DREAMWEAVER_IMAGE_EDIT_HIGH_ADAPTER=qwen_image_edit_max
DREAMWEAVER_IMAGE_EDIT_HIGH_POLICY=auto
DREAMWEAVER_IMAGE_EDIT_MULTI_REF=
DREAMWEAVER_IMAGE_EDIT_REF_MAX_IMAGES=3
DREAMWEAVER_IMAGE_EDIT_STRENGTH=0.65
DREAMWEAVER_IMAGE_EDIT_GUIDANCE=7.5

# 参考选择（recent / vlm）
DREAMWEAVER_REF_SELECTOR=recent

# AutoQC 语义一致性（默认关闭）
DREAMWEAVER_ENABLE_SEMANTIC_QC=false
DREAMWEAVER_SEMANTIC_THRESHOLD=0.6
DREAMWEAVER_SEMANTIC_VLM_ADAPTER=qwen3_vl_plus

# AutoQC 状态连续性（默认关闭；按“镜头对”计数）
DREAMWEAVER_ENABLE_STATE_QC=false
DREAMWEAVER_STATE_QC_THRESHOLD=0.65
DREAMWEAVER_STATE_QC_VLM_ADAPTER=qwen3_vl_plus
DREAMWEAVER_STATE_QC_STRATEGY=priority
DREAMWEAVER_STATE_QC_SAMPLE_RATE=1.0
# 0 表示不设上限（保持历史行为）；未显式配置但开启时，会注入默认预算兜底
DREAMWEAVER_STATE_QC_MAX_CHECKS=0
DREAMWEAVER_STATE_QC_ALWAYS_FIRST=true
DREAMWEAVER_STATE_QC_ALWAYS_LAST=true

# ==========================================
# 资产生成工作台模型配置
# ==========================================
IMAGE_GENERATION_MODELS=wan2.6-t2i,qwen-image-2.0,qwen-image-2.0-pro,wan2.7-image,doubao-seedream-4-5,doubao-seedream-5-0
VIDEO_GENERATION_MODELS=wan2.7-t2v,wan2.6-t2v-fast,wan2.7-i2v,wan2.7-r2v,doubao-seedance-2-0,doubao-seedance-2-0-fast,doubao-seedance-1-5-pro

# 织梦映心视频编辑 API
DREAMWEAVER_VIDEO_EDIT_API_KEY=your-video-edit-api-key

# Doubao Seed Audio 1.0 reuses DOUBAO_API_KEY by default.
# Optional override for accounts using a dedicated OpenSpeech key:
# VOLCENGINE_OPEN_SPEECH_API_KEY=
VOLCENGINE_OPEN_SPEECH_TIMEOUT=600
