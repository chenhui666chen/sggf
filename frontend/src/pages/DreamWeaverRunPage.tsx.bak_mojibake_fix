const LIB_PROMPT_APPEARANCE_KEYWORDS = ['鑴?, '浜斿畼', '鐪?, '鐪?, '榧?, '鍞?, '鍙?, '鍙戝瀷', '鍙戣壊', '浣撳瀷', '韬舰', '鏈?, '澶栧', '鎵嬪', '楗?, '鎺ュ彛', '鐤?, '绾?, '姘旇川', '绁炴儏', '鍔ㄤ綔']

function startsWithAny(text: string, prefixes: string[]): boolean {
  const value = String(text || '').trim()
  return prefixes.some((prefix) => value.startsWith(prefix))
}

function stripPromptPrefix(text: string, prefixes: string[]): string {
  const value = String(text || '').trim()
  for (const prefix of prefixes) {
    if (value.startsWith(prefix)) {
      return value.slice(prefix.length).trim()
    }
  }
  return value
}

function splitPromptSegments(text: string): string[] {
  return String(text || '')
    .replace(/\r/g, '\n')
    .replace(/[銆?]/g, '锛?)
    .split(/[锛沑n]+/)
    .map((item) => item.trim())
    .filter(Boolean)
}

function resolveCharacterViewFromRole(role: string): CharacterViewValue {
  const prefix = String(role || '').trim().split(':', 1)[0]
  if (prefix === 'lib_character_portrait_side') return 'side'
  if (prefix === 'lib_character_portrait_back') return 'back'
  if (prefix === 'lib_character_portrait') return 'front'
  return 'default'
}

function parseLibraryRoleEntityId(role: string): number | null {
  const text = String(role || '').trim()
  if (!text.includes(':')) return null
  const parts = text.split(':', 2)
  if (parts.length < 2) return null
  const entityId = Number(parts[1])
  if (!Number.isInteger(entityId) || entityId <= 0) return null
  return entityId
}

function resolveCharacterViewChainPlan(role: string): CharacterViewChainPlan {
  const prefix = String(role || '').trim().split(':', 1)[0]
  const entityId = parseLibraryRoleEntityId(role)
  if (!entityId) {
    return { forceImageEdit: false, baseRole: null, referenceRoles: [] }
  }
  const frontRole = `lib_character_portrait:${entityId}`
  const sideRole = `lib_character_portrait_side:${entityId}`
  if (prefix === 'lib_character_portrait_side') {
    return {
      forceImageEdit: true,
      baseRole: frontRole,
      referenceRoles: [frontRole],
    }
  }
  if (prefix === 'lib_character_portrait_back') {
    return {
      forceImageEdit: true,
      baseRole: sideRole,
      referenceRoles: [sideRole, frontRole],
    }
  }
  return { forceImageEdit: false, baseRole: null, referenceRoles: [] }
}

function formatReferenceRoleLabel(role: string): string {
  const view = resolveCharacterViewFromRole(role)
  if (view === 'front') return 'Front View'
  if (view === 'side') return 'Side View'
  if (view === 'back') return 'Back View'
  return role
}

function formatCharacterViewLabel(view: string): string {
  const normalized = String(view || '').trim().toLowerCase()
  if (normalized === 'front') return '姝ｉ潰'
  if (normalized === 'side') return '渚ч潰'
  if (normalized === 'back') return '鑳岄潰'
  return '鏈寚瀹?
}

function buildLibraryPromptBreakdown(prompt: string, role: string): LibraryPromptBreakdown {
  const lines = String(prompt || '')
    .replace(/\r/g, '\n')
    .split('\n')
    .map((line) => line.trim())
    .filter(Boolean)

  const styleLine = lines.find((line) => startsWithAny(line, LIB_PROMPT_STYLE_PREFIXES)) || ''
  const ratioLine = lines.find((line) => startsWithAny(line, LIB_PROMPT_RATIO_PREFIXES)) || ''
  const entityLine = lines.find((line) => startsWithAny(line, LIB_PROMPT_ENTITY_PREFIXES)) || ''
  const requirementLine = lines.find((line) => startsWithAny(line, LIB_PROMPT_REQUIREMENT_PREFIXES)) || ''
  const constraintLine = lines.find((line) => startsWithAny(line, LIB_PROMPT_CONSTRAINT_PREFIXES)) || ''

  const descriptorParts: string[] = []
  for (const line of lines) {
    if (startsWithAny(line, LIB_PROMPT_STYLE_PREFIXES)) continue
    if (startsWithAny(line, LIB_PROMPT_RATIO_PREFIXES)) continue
    if (startsWithAny(line, LIB_PROMPT_ENTITY_PREFIXES)) continue
    if (startsWithAny(line, LIB_PROMPT_REQUIREMENT_PREFIXES)) continue
    if (startsWithAny(line, LIB_PROMPT_CONSTRAINT_PREFIXES)) continue
    if (startsWithAny(line, LIB_PROMPT_SETTING_PREFIXES)) {
      const clean = stripPromptPrefix(line, LIB_PROMPT_SETTING_PREFIXES)
      if (clean) descriptorParts.push(clean)
      continue
    }
    descriptorParts.push(line)
  }

  const descriptorText = descriptorParts.join('锛?).trim()
  const segments = splitPromptSegments(descriptorText)
  const appearance: string[] = []
  const composition: string[] = []
  const consistency: string[] = []
  const other: string[] = []

  const includesAny = (text: string, keywords: string[]) => keywords.some((keyword) => text.includes(keyword))

  for (const seg of segments) {
    const value = String(seg || '').trim()
    if (!value) continue
    if (includesAny(value, LIB_PROMPT_CONSISTENCY_KEYWORDS)) {
      consistency.push(value)
      continue
    }
    if (includesAny(value, LIB_PROMPT_COMPOSITION_KEYWORDS)) {
      composition.push(value)
      continue
    }
    if (includesAny(value, LIB_PROMPT_APPEARANCE_KEYWORDS)) {
      appearance.push(value)
      continue
    }
    other.push(value)
  }

  const roleView = resolveCharacterViewFromRole(role)
  const textView = descriptorText.includes('渚ч潰') ? 'side' : descriptorText.includes('鑳岄潰') ? 'back' : descriptorText.includes('姝ｉ潰') ? 'front' : 'default'
  const characterView = roleView !== 'default' ? roleView : (textView as CharacterViewValue)
  const isCharacter = roleView !== 'default' || startsWithAny(entityLine, ['瑙掕壊锛?, '瑙掕壊:']) || String(prompt || '').includes('浜虹墿璁惧畾')

  return {
    isCharacter,
    characterView,
    styleLine,
    ratioLine,
    entityLine,
    descriptorText,
    requirementLine,
    constraintLine,
    appearance,
    composition,
    consistency,
    other,
  }
}

function formatBreakdownSection(segments: string[], maxItems = 4): string {
  const picked = (Array.isArray(segments) ? segments : []).filter((item) => String(item || '').trim())
  if (!picked.length) return '鏆傛棤璇嗗埆鐗囨'
  const lines = picked.slice(0, Math.max(1, maxItems)).map((item) => `鈥?${String(item).trim()}`)
  if (picked.length > maxItems) {
    lines.push(`鈥?杩樻湁 ${picked.length - maxItems} 鏉)
  }
  return lines.join('\n')
}

function parseStructuredSectionText(text: string): string[] {
  return String(text || '')
    .replace(/\r/g, '\n')
    .replace(/[銆?]/g, '锛?)
    .split(/[锛沑n]+/)
    .map((item) => item.replace(/^[-*鈥\s*/, '').trim())
    .filter(Boolean)
}

function joinStructuredSectionText(lines: string[]): string {
  return (Array.isArray(lines) ? lines : [])
    .map((item) => String(item || '').trim())
    .filter(Boolean)
    .join('\n')
}

function removeLineInSection(lines: string[], index: number): string[] {
  const items = [...(Array.isArray(lines) ? lines : [])]
  if (!items.length) return items
  if (index < 0 || index >= items.length) return items
  items.splice(index, 1)
  return items
}

function mergeUniqueSegments(...segmentGroups: string[][]): string[] {
  const seen = new Set<string>()
  const out: string[] = []
  for (const group of segmentGroups) {
    for (const raw of Array.isArray(group) ? group : []) {
      const text = String(raw || '').trim()
      if (!text) continue
      const key = text.replace(/\s+/g, '').toLowerCase()
      if (!key || seen.has(key)) continue
      seen.add(key)
      out.push(text)
    }
  }
  return out
}

function resolveSettingLabel(prompt: string, breakdown: LibraryPromptBreakdown): string {
  const lines = String(prompt || '')
    .replace(/\r/g, '\n')
    .split('\n')
    .map((line) => line.trim())
    .filter(Boolean)
  const settingLine = lines.find((line) => startsWithAny(line, LIB_PROMPT_SETTING_PREFIXES))
  if (settingLine) {
    if (settingLine.startsWith('鍦烘櫙璁惧畾')) return settingLine.includes('锛?) ? '鍦烘櫙璁惧畾锛? : '鍦烘櫙璁惧畾:'
    if (settingLine.startsWith('閬撳叿璁惧畾')) return settingLine.includes('锛?) ? '閬撳叿璁惧畾锛? : '閬撳叿璁惧畾:'
    return settingLine.includes('锛?) ? '浜虹墿璁惧畾锛? : '浜虹墿璁惧畾:'
  }
  if (startsWithAny(breakdown.entityLine, ['鍦烘櫙锛?, '鍦烘櫙:'])) return '鍦烘櫙璁惧畾锛?
  if (startsWithAny(breakdown.entityLine, ['閬撳叿锛?, '閬撳叿:'])) return '閬撳叿璁惧畾锛?
  return '浜虹墿璁惧畾锛?
}

function rebuildPromptWithSections(
  basePrompt: string,
  breakdown: LibraryPromptBreakdown,
  sections: {
    appearance: string[]
    composition: string[]
    consistency: string[]
    other: string[]
  },
): string {
  const descriptorSegments = mergeUniqueSegments(
    sections.appearance,
    sections.composition,
    sections.consistency,
    sections.other,
  )
  const descriptorText = descriptorSegments.join('锛?).trim()
  const settingLabel = resolveSettingLabel(basePrompt, breakdown)

  const lines: string[] = []
  if (breakdown.styleLine) lines.push(breakdown.styleLine)
  if (breakdown.ratioLine) lines.push(breakdown.ratioLine)
  if (breakdown.entityLine) lines.push(breakdown.entityLine)
  if (descriptorText) {
    lines.push(`${settingLabel}${descriptorText}`)
  }
  if (breakdown.requirementLine) lines.push(breakdown.requirementLine)
  if (breakdown.constraintLine) lines.push(breakdown.constraintLine)

  return lines.filter((line) => String(line || '').trim()).join('\n').trim()
}

