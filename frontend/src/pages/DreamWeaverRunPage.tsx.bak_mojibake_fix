                              : statusRaw === 'waiting'
                              ? '寰呭鏍?
                              : statusRaw === 'failed'
                              ? '澶辫触'
                              : statusRaw === 'timeout'
                              ? '瓒呮椂'
                              : statusRaw === 'running'
                              ? '杩愯涓?
                              : statusRaw === 'queued'
                              ? '鎺掗槦涓?
