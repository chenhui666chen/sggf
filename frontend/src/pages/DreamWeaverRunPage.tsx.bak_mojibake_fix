                  <DialogActions>
                    <Button onClick={closeDeleteRunDialog} disabled={deleteSubmitting}>
                      鍙栨秷
                    </Button>
                    <Button
                      variant="contained"
                      color="error"
                      onClick={confirmDeleteRun}
                      disabled={deleteSubmitting || !deleteRunId}
                    >
                      {deleteSubmitting ? '鍒犻櫎涓€? : '纭鍒犻櫎'}
                    </Button>
                  </DialogActions>
                </Dialog>

                <Snackbar
                  open={regenSuggestToast.open}
                  autoHideDuration={2200}
                  onClose={(_event, reason) => {
                    if (reason === 'clickaway') return
                    setRegenSuggestToast((prev) => ({ ...prev, open: false }))
                  }}
                  anchorOrigin={{ vertical: 'bottom', horizontal: 'center' }}
                >
                  <Alert
                    onClose={() => setRegenSuggestToast((prev) => ({ ...prev, open: false }))}
                    severity={regenSuggestToast.severity}
                    variant="filled"
                    sx={{ width: '100%' }}
                  >
                    {regenSuggestToast.message}
                  </Alert>
                </Snackbar>
              </CardContent>
            </Card>
          </Grid>
