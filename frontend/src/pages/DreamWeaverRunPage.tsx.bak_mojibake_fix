                <Dialog open={bulkDeleteDialogOpen} onClose={closeBulkDeleteDialog} fullWidth maxWidth="sm">
                  <DialogTitle>
                    <Stack direction="row" spacing={1} alignItems="center">
                      <WarningIcon sx={{ color: '#f44336' }} />
                      <Typography variant="h6">纭鎵归噺鍒犻櫎</Typography>
                    </Stack>
                  </DialogTitle>
                  <DialogContent dividers>
                    <Alert severity="warning" sx={{ mb: 2 }}>
                      姝ゆ搷浣滃皢绾ц仈鍒犻櫎绛涢€夊嚭鐨?runs 鐨勬暟鎹簱璁板綍涓?runs/{'{run_id}'} 浜х墿鏂囦欢锛堜笉鍙仮澶嶏級锛涗笉浼氬垹闄ら」鐩叕鍏辩礌鏉愬簱锛堝彲澶嶇敤锛夈€傝繍琛屼腑/鎺掗槦涓殑 run 灏嗚嚜鍔ㄨ烦杩囥€?
                    </Alert>
                    <Typography variant="body2" sx={{ mb: 1 }}>
                      鏈灏嗗垹闄わ細{bulkDeleteTargets.length} 涓?run锛涜烦杩囷細{bulkDeleteSkippedCount} 涓紙杩愯涓?鎺掗槦涓級銆?
                    </Typography>

                    {bulkDeleteProgress && (
                      <Stack spacing={1} sx={{ mb: 1 }}>
                        <LinearProgress
                          variant={bulkDeleteProgress.total > 0 ? 'determinate' : 'indeterminate'}
                          value={
                            bulkDeleteProgress.total > 0
                              ? Math.round((bulkDeleteProgress.current / bulkDeleteProgress.total) * 100)
                              : undefined
                          }
                        />
                        <Typography variant="caption" color="text.secondary">
                          杩涘害锛歿bulkDeleteProgress.current}/{bulkDeleteProgress.total}
                        </Typography>
                      </Stack>
                    )}

                    {bulkDeleteError && (
                      <Alert severity="error" sx={{ mt: 1 }}>
                        {bulkDeleteError}
                      </Alert>
                    )}

                    {bulkDeleteResult && (
                      <Alert severity={bulkDeleteResult.failed ? 'warning' : 'success'} sx={{ mt: 1 }}>
                        宸插垹闄わ細{bulkDeleteResult.deleted}锛涜烦杩囷細{bulkDeleteResult.skipped}锛涘け璐ワ細{bulkDeleteResult.failed}
                        {bulkDeleteResult.errors.length > 0 && (
                          <Box sx={{ mt: 1 }}>
                            {bulkDeleteResult.errors.slice(0, 6).map((msg) => (
                              <Typography key={msg} variant="caption" display="block" sx={{ fontFamily: 'monospace' }}>
                                {msg}
                              </Typography>
                            ))}
                            {bulkDeleteResult.errors.length > 6 && (
                              <Typography variant="caption" display="block" color="text.secondary">
                                鈥﹁繕鏈?{bulkDeleteResult.errors.length - 6} 鏉￠敊璇?
                              </Typography>
                            )}
                          </Box>
                        )}
                      </Alert>
                    )}
                  </DialogContent>
                  <DialogActions>
                    <Button onClick={closeBulkDeleteDialog} disabled={bulkDeleteSubmitting}>
                      {bulkDeleteResult ? '鍏抽棴' : '鍙栨秷'}
                    </Button>
                    {!bulkDeleteResult && (
                      <Button
                        variant="contained"
                        color="error"
                        onClick={confirmBulkDeleteRuns}
                        disabled={bulkDeleteSubmitting || bulkDeleteTargets.length === 0}
                      >
                        {bulkDeleteSubmitting ? '鍒犻櫎涓€? : '纭鎵归噺鍒犻櫎'}
                      </Button>
                    )}
