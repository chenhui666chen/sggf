                    <Stack direction="row" spacing={1} alignItems="center" flexWrap="wrap" sx={{ mb: 1 }}>
                      <Chip
                        size="small"
                        label={`鍏ㄩ儴 (${historyRuns.length})`}
                        color="default"
                        variant={historyStatusFilters.length === 0 ? 'filled' : 'outlined'}
