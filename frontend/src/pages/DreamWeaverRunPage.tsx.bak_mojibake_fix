                              ? 'success'
                              : statusRaw === 'failed'
                              ? 'error'
                              : statusRaw === 'waiting'
                              ? 'warning'
                              : statusRaw === 'timeout'
                              ? 'warning'
                              : statusRaw === 'running' || statusRaw === 'queued'
                              ? 'info'
                              : 'default'
                          const timeText = formatDateTime(run.updated_at || run.created_at)
                          const progressValue =
                            typeof run.progress === 'number' ? Math.max(0, Math.min(100, Math.round(run.progress))) : null

                          return (
