# 应用基础配置
APP_NAME=Novel Writing System API
APP_VERSION=1.0.0
DEBUG=True

# 数据库配置（当前后端仅支持 PostgreSQL）
DATABASE_URL=postgresql://novel_user:your_postgres_password@localhost:5432/novel_db
SQLALCHEMY_ECHO=False

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# DeepSeek 官方 API 配置（用于 deepseek-v4-pro / deepseek-v4-flash）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MODEL_NAME=deepseek-v4-pro

# 阿里云百炼 API 配置（用于 Qwen / Embedding / Qwen3-TTS / Wan 等 DashScope 能力）
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Audiobook shared audio library cloud storage
AUDIOBOOK_AUDIO_LIBRARY_STORAGE_DRIVER=local_fs
AUDIOBOOK_AUDIO_LIBRARY_OSS_PREFIX=shared/audio_library
AUDIOBOOK_AUDIO_LIBRARY_OSS_POLICY_MODEL=cosyvoice-v3.5-plus
# Self-owned Aliyun OSS driver. Use a RAM user/role with least privilege.
# AUDIOBOOK_AUDIO_LIBRARY_STORAGE_DRIVER=aliyun_oss
# AUDIOBOOK_AUDIO_LIBRARY_OSS_BUCKET=sggf-audio-library
# AUDIOBOOK_AUDIO_LIBRARY_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# AUDIOBOOK_AUDIO_LIBRARY_OSS_ACCESS_KEY_ID=
# AUDIOBOOK_AUDIO_LIBRARY_OSS_ACCESS_KEY_SECRET=
# Optional when using temporary STS credentials:
# AUDIOBOOK_AUDIO_LIBRARY_OSS_SECURITY_TOKEN=
# Enable only after audio.sggf.net DNS/OSS/HTTPS mapping is verified:
# AUDIOBOOK_AUDIO_LIBRARY_OSS_PUBLIC_HOST=https://audio.sggf.net
# Qwen3-TTS Flash 实际调用的模型 ID，推荐使用稳定快照版本
QWEN3_TTS_INSTRUCT_FLASH_MODEL_ID=qwen3-tts-instruct-flash

# Mureka AI 音乐服务配置（用于背景音乐生成）
MUREKA_API_KEY=your-mureka-api-key-here
MUREKA_API_URL=https://api.mureka.ai
# 自动裁剪水印尾段的时长（秒），不需要时设为 0
MUREKA_WATERMARK_TRIM=3.0

# Fal.ai 声效服务配置（用于环境音 / 音效生成）
FAL_KEY=your-fal-api-key-here

# Embedding 模型配置（选择其中一种）

# 选项 1：阿里云百炼 embedding（推荐）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=your-dashscope-api-key-here
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 选项 2：OpenAI embedding
# EMBEDDING_MODEL=text-embedding-ada-002
# EMBEDDING_API_KEY=your_openai_api_key
# EMBEDDING_API_BASE=https://api.openai.com/v1

# 向量数据库配置
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Agent 配置
TEMPERATURE=0.7
MAX_CONTEXT_LENGTH=4000

# 模型优化配置
MODEL_OPTIMIZATION_STRATEGY=conservative

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# 邮件发送配置（正式找回密码必填）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=拾光工坊
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# 找回密码配置
PASSWORD_RESET_CODE_TTL_SECONDS=600
PASSWORD_RESET_RESEND_INTERVAL_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_LENGTH=6

# Celery 任务队列
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS 配置
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 腾讯云 API 配置（用于 AI 生成检测）
# 请在腾讯云控制台创建 API 密钥：https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key
TENCENT_REGION=ap-guangzhou
# 可选：在腾讯云内容安全控制台创建策略后填写 Biztype
TENCENT_BIZTYPE=
