# 应用基础配置
APP_NAME=Shiguang Studio API
APP_VERSION=1.0.0
# 运行环境：development | staging | production（生产/staging 启动时强制安全校验）
APP_ENV=development
DEBUG=False

# 数据库配置（当前后端仅支持 PostgreSQL）
DATABASE_URL=postgresql://novel_user:your_postgres_password@localhost:5432/novel_db
SQLALCHEMY_ECHO=False

# JWT 配置（P1-3.7 短 token 方案：短 access + refresh 轮换）
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
# access token 有效期（分钟，15-30；不再使用 24 小时长 token）
JWT_ACCESS_EXPIRATION_MINUTES=30
# refresh token 有效期（天，Redis 存 SHA-256 哈希，轮换制）
JWT_REFRESH_EXPIRATION_DAYS=7

# DeepSeek 官方 API 配置（用于 deepseek-v4-pro / deepseek-v4-flash）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MODEL_NAME=deepseek-v4-pro

# 阿里云百炼 API 配置（用于 Qwen / Embedding / Qwen3-TTS / Wan 等 DashScope 能力）
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 有声书 Seed 场景字幕 ASR（默认使用支持本地音频的 fun-asr-flash）
PROMPT_AUDIO_ASR_PROVIDER=funasr_flash
PROMPT_AUDIO_ASR_TIMEOUT_SECONDS=300
PROMPT_AUDIO_ASR_MAX_ATTEMPTS_PER_SCENE=2
PROMPT_AUDIO_ASR_MAX_COST_YUAN_PER_SCENE=0.2
FUNASR_FLASH_ASR_MODEL=fun-asr-flash-2026-06-15
DASHSCOPE_ASR_MODEL=paraformer-v2
# 豆包候选需 OpenSpeech API Key；1.0 标准版为 volc.bigasr.auc，2.0 为 volc.seedasr.auc
VOLCENGINE_OPEN_SPEECH_API_KEY=your-volcengine-openspeech-api-key-here
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc

# 单片段工作台口述录音转写专用 provider（不影响全局 PROMPT_AUDIO_ASR_PROVIDER）
# 可选值：funasr_flash（默认纯转写）、qwen_omni（音频理解：转写+表演特征描述）
# SEGMENT_DIRECTION_AUDIO_PROVIDER=qwen_omni
# QWEN_OMNI_DIRECTION_MODEL=qwen3.5-omni-flash
# QWEN_OMNI_DIRECTION_API_KEY 未设时回退 DASHSCOPE_ASR_API_KEY / DASHSCOPE_API_KEY / ALIYUN_API_KEY

# Audiobook shared audio library cloud storage
AUDIOBOOK_AUDIO_LIBRARY_STORAGE_DRIVER=local_fs
AUDIOBOOK_AUDIO_LIBRARY_OSS_PREFIX=shared/audio_library
AUDIOBOOK_AUDIO_LIBRARY_OSS_POLICY_MODEL=cosyvoice-v3.5-plus
# Self-owned Aliyun OSS driver. Use a RAM user/role with least privilege.
# AUDIOBOOK_AUDIO_LIBRARY_STORAGE_DRIVER=aliyun_oss
# AUDIOBOOK_AUDIO_LIBRARY_OSS_BUCKET=sggf-audio-library
# AUDIOBOOK_AUDIO_LIBRARY_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# AUDIOBOOK_AUDIO_LIBRARY_OSS_ACCESS_KEY_ID=
# AUDIOBOOK_AUDIO_LIBRARY_OSS_ACCESS_KEY_SECRET=
# Optional when using temporary STS credentials:
# AUDIOBOOK_AUDIO_LIBRARY_OSS_SECURITY_TOKEN=
# Enable only after audio.sggf.net DNS/OSS/HTTPS mapping is verified:
# AUDIOBOOK_AUDIO_LIBRARY_OSS_PUBLIC_HOST=https://audio.sggf.net
# Qwen3-TTS Flash 实际调用的模型 ID，推荐使用稳定快照版本
QWEN3_TTS_INSTRUCT_FLASH_MODEL_ID=qwen3-tts-instruct-flash

# Mureka AI 音乐服务配置（用于背景音乐生成）
MUREKA_API_KEY=your-mureka-api-key-here
MUREKA_API_URL=https://api.mureka.ai
# 自动裁剪水印尾段的时长（秒），不需要时设为 0
MUREKA_WATERMARK_TRIM=3.0

# Fal.ai 声效服务配置（用于环境音 / 音效生成）
FAL_KEY=your-fal-api-key-here

# Embedding 模型配置（选择其中一种）

# 选项 1：阿里云百炼 embedding（推荐）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=your-dashscope-api-key-here
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 选项 2：OpenAI embedding
# EMBEDDING_MODEL=text-embedding-ada-002
# EMBEDDING_API_KEY=your_openai_api_key
# EMBEDDING_API_BASE=https://api.openai.com/v1

# 向量数据库配置
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Agent 配置
TEMPERATURE=0.7
MAX_CONTEXT_LENGTH=4000

# 多模型质量评审（高级功能，默认关闭）
MULTI_MODEL_REVIEW_CONCURRENCY=5
MULTI_MODEL_REVIEW_TIMEOUT_SECONDS=120
MULTI_MODEL_REVIEW_DEFAULT_PRESET=balanced_3
MULTI_MODEL_REVIEW_MAX_REVIEWERS=7
MULTI_MODEL_REVIEW_CHIEF_MODEL=deepseek-v4-pro
MULTI_MODEL_REVIEW_DEFAULT_PROMPT_BUDGET=80000
DOUBAO_REVIEW_PROMPT_BUDGET=64000

# 模型优化配置
MODEL_OPTIMIZATION_STRATEGY=conservative

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# 邮件发送配置（正式找回密码必填）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=拾光工坊
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# 找回密码配置
PASSWORD_RESET_CODE_TTL_SECONDS=600
PASSWORD_RESET_RESEND_INTERVAL_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_LENGTH=6

# 邮箱验证配置（两步注册 / 登录态邮箱验证）
EMAIL_VERIFY_CODE_TTL_SECONDS=600
EMAIL_VERIFY_RESEND_INTERVAL_SECONDS=60
EMAIL_VERIFY_MAX_ATTEMPTS=5
EMAIL_VERIFY_CODE_LENGTH=6

# 认证端点限流（每分钟次数；P1-3.1）
AUTH_RATE_LIMIT_LOGIN_IP_PER_MINUTE=20
AUTH_RATE_LIMIT_LOGIN_ACCOUNT_PER_MINUTE=5
AUTH_RATE_LIMIT_REGISTER_PER_MINUTE=3
AUTH_RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=1

# 密码策略与锁定（P2-4.6）
# 复杂度下限（≥8，含大小写字母和数字；上限固定 50）
PASSWORD_MIN_LENGTH=8
# 连续失败 5 次锁定 15 分钟（Redis 独立 key，与 3.1 限流互不干扰）
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
# 密码历史独立 pepper（仅用于 password_history 的 HMAC；生产/staging 缺省或沿用占位值即拒绝启动）
# 生成：openssl rand -hex 32
# ⚠️ 占位值仅限本地开发，禁止用于任何共享/联调环境（占位值等于已知 key，评审 #5）
PASSWORD_HISTORY_PEPPER=your-password-history-pepper-change-in-production
# 密码历史保留条数（含当前密码；评审 #9）
PASSWORD_HISTORY_SIZE=3

# 审计日志（P2-4.4）：IP/User-Agent 脱敏哈希独立 pepper，任何环境不得为空
# 生成：openssl rand -hex 32；禁止与登录/密码历史/openid 复用同一 key
AUDIT_LOG_PEPPER=
# 审计日志保留天数（5.3：90 天，超期由清理任务/懒清理删除）
AUDIT_LOG_RETENTION_DAYS=90
# 账户注销冷静期（4.3/5.3：注销后保留天数，之后由匿名化脚本处理）
ACCOUNT_DELETE_COOLING_DAYS=30

# Cookie 认证（P2-4.5）：access/refresh/csrf 均入 httpOnly cookie
# 生产/预发布：COOKIE_SECURE=true、COOKIE_PREFIX=__Host-（要求 HTTPS）
# 本地开发（http://localhost）：COOKIE_SECURE=false、COOKIE_PREFIX= 空
COOKIE_SECURE=true
COOKIE_PREFIX=__Host-
# 初始超管密码（init_admin_data 去硬编码；production/staging 必填，development 缺省随机）
INITIAL_ADMIN_PASSWORD=

# Celery 任务队列
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Free chapter generation tier. Enable explicitly when releasing it in production.
FREE_TIER_ENFORCEMENT_ENABLED=false
FREE_TIER_STANDARD_ROLE_CODES=super_admin,admin,standard_generation
FREE_TIER_DAILY_CHAPTER_LIMIT=2
# Daily free chapter guardrail; this is not a token-based cost limit.
FREE_TIER_GLOBAL_DAILY_LIMIT=500

# CORS 配置
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 朱雀 AIGC 检测（EdgeOne AI 网关 zhuque-text，创建网关后分配）
ZHUQUE_GATEWAY_URL=
ZHUQUE_API_KEY=
# 段切分模式：false=段级真值（2026-08-28 冒烟定夺，全文分与合并模式一致，单次调用即可）
ZHUQUE_IS_MERGE=false

# 支付宝 OAuth 登录（开放平台网页应用，授权回调域需与应用回调地址一致）
ALIPAY_APP_ID=
# 应用私钥（单行 Base64，PKCS#8；切勿提交到代码仓库）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（开放平台配置密钥后生成的单行 Base64）
ALIPAY_PUBLIC_KEY=
# 沙箱环境开关（沙箱网关为 openapi.alipaydev.com）
ALIPAY_SANDBOX=False

# 微信 OAuth 登录（微信开放平台网站应用，资质审核通过后生成 AppSecret）
# 授权回调域需在开放平台与应用回调地址一致，且必须同时收录进下方 OAUTH_REDIRECT_URI_WHITELIST；
# 两项均未配置时接口 fail-closed 返回 503（“微信登录尚未完成服务端配置”）
WECHAT_APP_ID=
# AppSecret 属敏感凭证：切勿提交到代码仓库或写入日志（换票 URL 会携带，禁止记录）
WECHAT_APP_SECRET=

# openid 加密存储（P2-4.1）：两把独立密钥，必须分开存储，生产/staging 缺失即拒绝启动
# 查找哈希密钥：任意随机串（openssl rand -hex 32）；轮换需离线重算全表哈希，极低频
OPENID_LOOKUP_KEY=
# 加密密钥：32 字节 urlsafe-base64
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPENID_ENCRYPTION_KEY=

# OAuth 回调地址精确白名单（staging/生产仅 HTTPS）。只需填写对外域名；
# 开发环境（APP_ENV=development）会在启动时自动追加 http://localhost:5173/login/callback，无需手动添加
OAUTH_REDIRECT_URI_WHITELIST=["https://your-domain.com/login/callback"]
