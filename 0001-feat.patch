+    设置全局Engine实例
+    
+    用于后台任务中
+    """
+    global _global_engine_instance
+    _global_engine_instance = engine
+
+__all__ = [
+    "AudiobookEngine",
+    "TextParser",
+    "VoiceManager",
+    "VoiceProfile",
+    "TTSEngine",
+    "AudioMixer",
+    "get_engine_instance",
