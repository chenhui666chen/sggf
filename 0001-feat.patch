+
+# 全局Engine实例（用于任务状态查询）
+# ⚠️ 重要：reload时会重置为None，强制重建实例
+# 每次模块加载时重置，确保使用最新配置
+_global_engine_instance = None
+
+
+def get_engine_instance() -> AudiobookEngine:
+    """
+    获取全局Engine实例
+    
