+                # 同步调用（dashscope暂不支持async）
+                loop = asyncio.get_event_loop()
+                result = await loop.run_in_executor(
+                    None,
+                    synthesizer.call,
+                    text
+                )
+                
+                # 检查结果（兼容两种返回格式）
+                audio_data = None
+                
+                # 详细记录返回结果
+                logger.debug(f"🔍 返回类型: {type(result)}")
